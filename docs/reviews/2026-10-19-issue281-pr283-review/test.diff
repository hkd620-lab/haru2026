+    ['kakao', 'google.com', 'kakao'], [' GOOGLE.com ', 'naver', 'google'],
+    [null, ' NAVER ', 'naver'], ['unsupported', ' PASSWORD ', 'password'],
+    [null, 'unsupported', 'custom'], ['unsupported', undefined, 'custom'], [null, undefined, 'custom'],
