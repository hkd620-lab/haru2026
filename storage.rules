rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 사용자별 이미지 업로드 허용 (records 내부)
    match /users/{userId}/records/{recordId}/{format}/images/{imageId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ✅ 변화기록 비서 PNG 업로드
    match /users/{userId}/timelines/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && fileName.matches('.*\\.png');
      allow write: if request.auth != null
        && request.auth.uid == userId
        && fileName.matches('.*\\.png')
        && request.resource.contentType == 'image/png';
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && fileName.matches('.*\\.png');
    }

    // ✅ FormatModal 업로드 경로(users/{uid}/format_photos/...) 허용
    match /users/{userId}/format_photos/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // ✅ SNS 기록 가져오기 — Facebook ZIP 업로드 경로 (분석 후 함수가 삭제)
    match /users/{userId}/snsUploads/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // ✅ SNS 기록 가져오기 — 분석 결과 썸네일 (Functions가 생성·makePublic 처리)
    match /users/{userId}/snsThumbnails/{docId}/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }

    // ✅ K뉴스 카드뉴스 이미지 — 개발자만 발행, 인증 사용자 read
    match /k-news/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null
        && request.auth.uid == 'naver_lGu8c7z0B13JzA5ZCn_sTu4fD7VcN3dydtnt0t5PZ-8';
    }
  }
}
