rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isVaultDeveloper(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == "hkd620@gmail.com";
    }

    // 사용자별 이미지 업로드 허용 (records 내부)
    match /users/{userId}/records/{recordId}/{format}/images/{imageId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 정보금고 확인용 압축 이미지
    match /users/{userId}/vault/images/{itemId}/{fileName} {
      allow read: if isVaultDeveloper(userId);
      allow write: if isVaultDeveloper(userId)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isVaultDeveloper(userId);
    }

    // ✅ HARU타임라인 PNG 업로드
    match /users/{userId}/timelines/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && fileName.matches('.*\\.png');
      allow write: if request.auth != null
        && request.auth.uid == userId
        && fileName.matches('.*\\.png')
        && request.resource.contentType == 'image/png'
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && fileName.matches('.*\\.png');
    }

    // ✅ FormatModal 업로드 경로(users/{uid}/format_photos/...) 허용
    match /users/{userId}/format_photos/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ✅ 하루식물탐정 사용자 확정 저장 경로(users/{uid}/plants/...) 허용
    match /users/{userId}/plants/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ✅ SNS 기록 가져오기 — Facebook ZIP 업로드 경로 (분석 후 함수가 삭제)
    // 브라우저별 zip contentType 표기가 제각각이라 MIME은 제한하지 않고 크기만 제한
    // (analyzeFacebookZip이 파일 전체를 메모리로 내려받으므로 대용량 유입 자체를 차단)
    match /users/{userId}/snsUploads/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 100 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ✅ SNS 기록 가져오기 — 분석 결과 썸네일 (Functions가 생성·makePublic 처리)
    match /users/{userId}/snsThumbnails/{docId}/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }

    // ✅ K뉴스 카드뉴스 이미지 — 개발자만 발행, 인증 사용자 read
    match /k-news/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null
        && request.auth.uid == 'naver_lGu8c7z0B13JzA5ZCn_sTu4fD7VcN3dydtnt0t5PZ-8';
    }

    // ✅ 오늘충전 이미지 — 개발자만 발행, 인증 사용자 read
    match /today-charge/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null
        && request.auth.uid == 'naver_lGu8c7z0B13JzA5ZCn_sTu4fD7VcN3dydtnt0t5PZ-8';
    }

    // ✅ 프로필 이미지 업로드 경로(profile_images/{uid}/avatar.jpg) — 기존 규칙에 누락되어 있던 경로 추가
    // (imageService.ts uploadProfileImage가 이미 이 경로로 업로드 중이나 이전까지 매칭되는 규칙이 없어 기본 거부 상태였음)
    match /profile_images/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 하루LAW 자문 첨부 파일: 본인 경로만 접근, 구독 권한은 Functions에서 추가 확인
    match /users/{userId}/haruLawAttachments/{recordId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (
          (
            request.resource.contentType.matches('image/.*')
            && request.resource.size < 7 * 1024 * 1024
          )
          || (
            request.resource.contentType == 'application/pdf'
            && request.resource.size < 50 * 1024 * 1024
          )
        );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
